# Optional settings for Music Bingo. Copy to ".env" (./run.sh makes .env for you with DB_PASSWORD) and add what you need.
# You can leave all of these out: the setup screen in the browser asks for the important ones, and an admin can change
# them later on the Admin page. A value set here wins over the one saved in the app.

# Made by ./run.sh. The database password (only the app container can reach the database; without it docker-compose.yml
# uses a built-in one, which is fine because the database is on a private network). Don't change it after the first start.
# DB_PASSWORD=

# Port on this machine
# BINGO_PORT=5000

# The public address people open (join links, QR codes, Spotify sign-in), for example https://bingo.example.com
# PUBLIC_BASE_URL=

# Your Spotify developer app (https://developer.spotify.com/dashboard)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Only if the redirect address must differ from <public address>/auth/spotify/callback (for example
# http://127.0.0.1:5000/auth/spotify/callback when you try it on your own computer):
# SPOTIFY_REDIRECT_URI=

# Unattended installs: create the admin account from this password instead of showing the setup screen
# HOST_ADMIN_PASSWORD=

# Normally made by the app and kept in its data volume. Set it only to use your own (keep it stable: changing it signs
# everyone out and makes already printed paper cards fail their check codes).
# COOKIE_SECRET=

# true when a proxy such as Cloudflare or nginx sets the visitor's address (default); false if the app is reached directly
# TRUST_PROXY_HEADERS=true
